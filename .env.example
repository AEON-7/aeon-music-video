# aeon-music-video — environment variables.
# Copy to .env and edit. Both scripts read these via os.environ.

# === Binary paths (rely on PATH if unset) ===
# FFMPEG=/usr/bin/ffmpeg
# FFPROBE=/usr/bin/ffprobe

# === Default output framerate ===
# DEFAULT_FPS=24

# === Default output resolution (smooth compositor) ===
# DEFAULT_WIDTH=832
# DEFAULT_HEIGHT=480

# === Default DMT-mode resolution (vertical for short-form social) ===
# DMT_WIDTH=720
# DMT_HEIGHT=1280

# === Default loudness target for embedded audio (LUFS) ===
# Lower = louder, but less dynamic range. -12 is typical for EDM.
# DEFAULT_LUFS=-12.0
